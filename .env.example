# Telegram Bot Configuration
TELEGRAM_TOKEN=your-telegram-token
TELEGRAM_MAIN_GROUP=chat-id-or-group-id

# Node Configuration
NODE_ID=1
NODE_HAS_BATTERY=0
NODE_TYPE=LINUX
NODE_DEBUG=0

# Storage Backend Mode: BACKEND, SPREADSHEET, or COMBINED
DATA_BACKEND=BACKEND

# Serverless Backend Configuration (e.g., Vercel deployment)
BACKEND_URL=https://your-project.vercel.app
BACKEND_API_KEY=optional-secret-key

# Google Spreadsheet Configuration (Optional / Legacy)
# Required only if DATA_BACKEND is SPREADSHEET or COMBINED
SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/your-spreadsheet-id
MAIN_SHEET_ID=0
NODE_SHEET_ID=123456789
